<?xml version="1.0" encoding="utf-8"?>
<!--
  Ejemplo de configuración local. Para usarlo:
    1. Copiá este archivo en la misma carpeta con el nombre appSettings.local.config
       (ese nombre está en el .gitignore: no se sube al repo).
    2. Cambiá la cadena de conexión por la de tu SQL Server.
  Lo que pongas acá pisa el valor del Web.config.
-->
<appSettings>
  <!-- Ejemplo para SQL Server en Docker (usuario y contraseña de SQL Server). -->
  <add key="ConexionUtnHardware" value="Server=localhost,1433;Database=UtnHardware;User Id=sa;Password=TU_CLAVE;" />
</appSettings>
